---
import '../styles/components/person-card.css';

interface Props {
  name: string;
  role: string;
  qualification?: string;
  graduation_year?: number;
  area?: string;
  email?: string;
  page?: string;
  labs?: string[];
  research_group?: { name: string; url: string };
}

const { name, role, qualification, graduation_year, area, email, page, labs, research_group } = Astro.props;
---

<div class="person-card" data-graduation-year={graduation_year} data-person-name={name}>
  <div class="person-card__name">
    {page ? <a href={page} target="_blank" rel="noopener noreferrer">{name}</a> : name}
  </div>
  <div class="person-card__role">{role}</div>
  {qualification && <div class="person-card__qualification">{qualification}</div>}
  {graduation_year && <div class="person-card__graduation-year">Graduation year: {graduation_year}</div>}
  {area && <div class="person-card__area">{area}</div>}
  {email && <div class="person-card__email">{email}</div>}
  {labs && labs.length > 0 && <div class="person-card__lab">{labs.join(', ')}</div>}
  {research_group && (
    <div class="person-card__lab">
      Research Group: <a href={research_group.url} target="_blank" rel="noopener noreferrer">{research_group.name}</a>
    </div>
  )}
</div>
