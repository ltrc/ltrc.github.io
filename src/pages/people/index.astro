---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PeopleDirectory from '../../components/PeopleDirectory.astro';
import { getSingle } from '../../lib/content';
import { PEOPLE_CATEGORIES, membersByType } from '../../lib/people';

const allMembers = (await getSingle('people')).members;

const grouped = PEOPLE_CATEGORIES
  .map((cat) => ({ ...cat, members: membersByType(allMembers, cat.type) }))
  .filter((cat) => cat.members.length > 0);
---

<Base title="People" description="Faculty, researchers, students, and staff at LTRC, IIIT Hyderabad.">

  <PageHeader
    title="People"
    description="Faculty, researchers, students, and staff at the Language Technologies Research Centre, IIIT Hyderabad."
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'People' }]}
  />

  <section class="page-section">
    <div class="container">
      <nav class="people-nav">
        {grouped.map((cat) => (
          <a href={cat.href} class="people-nav__link">
            {cat.label}
            <span class="people-nav__count">{cat.members.length}</span>
          </a>
        ))}
      </nav>

      <PeopleDirectory groups={grouped} />
    </div>
  </section>

</Base>
